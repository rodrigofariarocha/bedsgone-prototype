---
import MattressScene from './MattressScene.astro';
import { BUSINESS, METROS, PICKUP_SPOTS } from '../lib/config';
---

<section class="relative flex min-h-[92svh] flex-col justify-between overflow-hidden lg:min-h-[100svh]">
  <div class="blob -left-40 top-10 h-[34rem] w-[34rem] bg-sand-100"></div>
  <div class="blob -right-32 bottom-0 h-[30rem] w-[30rem] bg-sand-50"></div>

  <div class="container-page relative z-10 flex flex-1 flex-col lg:block">
    <!-- On a phone the truck gets its own band under the card; on a desktop it
         spans the whole hero and sits behind the type. -->
    <div class="relative order-2 mt-6 h-[30svh] w-full lg:absolute lg:inset-0 lg:order-none lg:mt-0 lg:h-full">
      <MattressScene class="absolute inset-0" />
    </div>

    <div class="relative order-1 w-full max-w-[34rem] pt-[12vh] lg:pt-[18vh]">
      <h1
        class="display text-[clamp(2.7rem,7.2vw,5.4rem)]"
        data-anim="lines"
        data-anim-hero
        data-anim-delay="0.1"
      >
        <span class="line"><span class="line-i">Your old</span></span>
        <span class="line"><span class="line-i">mattress,</span></span>
        <span class="line"><span class="line-i text-brand">gone.</span></span>
      </h1>

      <p
        class="mt-6 max-w-sm leading-relaxed text-ink-soft"
        data-anim="fade"
        data-anim-hero
        data-anim-delay="0.45"
      >
        Flat price, two-hour window, gone tomorrow. Size and type never change what you pay.
      </p>

      <!-- Booking card. Held back until the mattress is in the truck, then
           revealed — it is the payoff of the intro. -->
      <div class="card mt-8 max-w-md p-5 shadow-soft sm:p-6" data-anim="fade" data-loaded-card>
        <p class="text-[0.7rem] font-semibold uppercase tracking-[0.16em] text-ink-soft">
          Where will it be?
        </p>

        <div class="mt-4 grid gap-2.5 sm:grid-cols-2">
          {
            PICKUP_SPOTS.map((spot) => (
              <a
                href={`/book?spot=${spot.key}`}
                class="group rounded-2xl border border-line p-4 transition duration-300 hover:-translate-y-0.5 hover:border-brand hover:bg-sand-50"
              >
                <span class="block font-display text-3xl font-extrabold transition-colors duration-300 group-hover:text-brand">
                  ${spot.price}
                </span>
                <span class="mt-1.5 block text-sm font-semibold">{spot.label}</span>
                <span class="mt-0.5 block text-xs leading-snug text-ink-soft">{spot.sub}</span>
              </a>
            ))
          }
        </div>

        <a href="/book" class="btn btn-primary mt-4 w-full">
          Book a pickup
          <svg class="h-4 w-4" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M4 10h11m0 0-4.5-4.5M15 10l-4.5 4.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      </div>
    </div>
  </div>

  <!-- bottom rail -->
  <div class="container-page relative z-10 pb-8">
    <div class="hairline"></div>
    <div
      class="flex flex-wrap items-center justify-between gap-4 pt-5 text-[0.68rem] font-semibold uppercase tracking-[0.16em] text-ink-soft"
      data-anim="fade"
      data-anim-hero
      data-anim-delay="0.8"
    >
      <p>{BUSINESS.hours} · {METROS.length} US metros · Recycled, not landfilled</p>

      <a href="#how" class="group flex items-center gap-3">
        Scroll
        <span class="grid h-9 w-9 place-items-center rounded-full border border-line transition group-hover:border-brand group-hover:bg-sand-50">
          <svg viewBox="0 0 20 20" class="h-4 w-4 text-brand" fill="none" aria-hidden="true">
            <path d="M10 4v12m0 0 4.5-4.5M10 16l-4.5-4.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </span>
      </a>
    </div>
  </div>
</section>

<script>
  import { playReveal, reducedMotion, whenEntered } from '../lib/motion';

  // The hero does not wait for a scroll trigger — it plays the moment the
  // loader lifts, so the type and the truck arrive together.
  whenEntered(() => {
    if (reducedMotion) return;
    document.querySelectorAll<HTMLElement>('[data-anim-hero]').forEach((el) => playReveal(el));
  });

  // The card is the payoff: it lands once the mattress is in the truck. A
  // timeout backs it up so a slow or missing 3D scene can never leave the
  // primary call to action hidden.
  const card = document.querySelector<HTMLElement>('[data-loaded-card]');
  if (card) {
    let shown = false;
    const reveal = () => {
      if (shown) return;
      shown = true;
      playReveal(card, 0);
    };
    window.addEventListener('bg:loaded', reveal, { once: true });
    window.setTimeout(reveal, 9000);
  }
</script>
