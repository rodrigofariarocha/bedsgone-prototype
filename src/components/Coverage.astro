---
import SectionHead from './SectionHead.astro';
import { METROS, OUT_OF_AREA_FEE } from '../lib/config';
---

<section id="areas" class="container-page scroll-mt-28 py-24 lg:py-32">
  <div class="grid gap-14 lg:grid-cols-[1fr_1.1fr] lg:gap-20">
    <div>
      <SectionHead
        index="03"
        label="Service area"
        lines={['How far', 'do we come?']}
        lead={`Daily routes in ten metros, up to 40 miles out from each depot. Outside that ring we still take the job — it picks up a $${OUT_OF_AREA_FEE} travel fee on the quote.`}
      />

      <form id="area-form" class="mt-10 max-w-sm" novalidate data-anim="fade" data-anim-delay="0.25">
        <label class="field-label" for="area-zip">Check a ZIP code</label>
        <div class="flex gap-2">
          <input id="area-zip" class="input" type="text" inputmode="numeric" maxlength="5" placeholder="94110" autocomplete="postal-code" />
          <button class="btn btn-primary !px-6" type="submit">Check</button>
        </div>
        <p id="area-result" class="mt-3 text-sm" role="status" aria-live="polite"></p>
      </form>
    </div>

    <ul class="grid gap-px overflow-hidden rounded-3xl border border-line bg-line sm:grid-cols-2" data-anim="stagger">
      {
        METROS.map((metro) => (
          <li class="group flex items-center gap-4 bg-white px-6 py-5 transition-colors duration-500 hover:bg-sand-50" data-anim-child>
            <span class="grid h-10 w-10 flex-none place-items-center rounded-full bg-sand-100 transition-colors duration-500 group-hover:bg-brand">
              <svg viewBox="0 0 20 20" class="h-4 w-4 text-brand transition-colors duration-500 group-hover:text-white" fill="none" aria-hidden="true">
                <path d="M10 17s5.5-4.9 5.5-9a5.5 5.5 0 1 0-11 0c0 4.1 5.5 9 5.5 9Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
                <circle cx="10" cy="8" r="1.9" stroke="currentColor" stroke-width="1.6" />
              </svg>
            </span>
            <div class="min-w-0">
              <p class="truncate font-display text-base font-bold tracking-tight">{metro.name}</p>
              <p class="text-xs text-ink-soft">{metro.state} · {metro.radius} mi radius</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  import { lookupZip } from '../lib/config';

  const form = document.getElementById('area-form') as HTMLFormElement | null;
  const input = document.getElementById('area-zip') as HTMLInputElement | null;
  const out = document.getElementById('area-result');

  if (form && input && out) {
    input.addEventListener('input', () => {
      input.value = input.value.replace(/\D/g, '').slice(0, 5);
    });

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const zip = input.value.trim();
      if (zip.length !== 5) {
        out.textContent = 'Enter a five-digit ZIP code.';
        out.style.color = '#e11d48';
        return;
      }
      const hit = lookupZip(zip);
      if (hit.status === 'covered' && hit.metro) {
        out.innerHTML = `✓ <strong>${hit.metro.name}</strong> — daily routes, next-day slots. <a class="link-underline font-semibold" href="/book?zip=${zip}">Book now →</a>`;
        out.style.color = '#a8380a';
      } else {
        out.innerHTML = `No daily route yet — we will quote it with a travel fee. <a class="link-underline font-semibold" href="/book?zip=${zip}">Get a quote →</a>`;
        out.style.color = '#6b5f71';
      }
    });
  }
</script>
