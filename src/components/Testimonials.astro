---
const quotes = [
  {
    body: 'Booked at 9pm, gone by 11am the next morning. The crew took a king down three flights without a scratch on the walls.',
    name: 'Dana R.',
    place: 'Brooklyn, NY',
  },
  {
    body: 'The price on the website was the price on the invoice. That alone puts them ahead of every hauler I called.',
    name: 'Marcus T.',
    place: 'Austin, TX',
  },
  {
    body: 'I liked getting the recycling receipt. It felt better than leaving a mattress on the curb for two weeks.',
    name: 'Priya S.',
    place: 'Seattle, WA',
  },
];
---

<section class="container-page py-12 lg:py-16">
  <div class="grid gap-px overflow-hidden rounded-3xl border border-line bg-line md:grid-cols-3" data-anim="stagger">
    {
      quotes.map((quote) => (
        <figure class="flex flex-col gap-6 bg-white p-8 lg:p-10" data-anim-child>
          <div class="flex gap-1 text-brand" aria-label="5 out of 5 stars">
            {[0, 1, 2, 3, 4].map(() => (
              <svg viewBox="0 0 20 20" class="h-4 w-4" fill="currentColor" aria-hidden="true">
                <path d="m10 2 2.4 5 5.6.8-4 3.9 1 5.5-5-2.7-5 2.7 1-5.5-4-3.9 5.6-.8L10 2Z" />
              </svg>
            ))}
          </div>
          <blockquote class="font-display text-xl font-semibold leading-snug tracking-tight">
            “{quote.body}”
          </blockquote>
          <figcaption class="mt-auto flex items-center gap-3 pt-2">
            <span class="grid h-9 w-9 place-items-center rounded-full bg-sand-100 font-display text-sm font-bold text-brand-deep">
              {quote.name.charAt(0)}
            </span>
            <span>
              <span class="block text-sm font-bold">{quote.name}</span>
              <span class="block text-xs text-ink-soft">{quote.place}</span>
            </span>
          </figcaption>
        </figure>
      ))
    }
  </div>
</section>
